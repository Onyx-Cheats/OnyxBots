{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "start": "node server/index.mjs",
    "test": "node --test",
    "build": "vite build && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --fix --quiet",
    "lint:js": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "lint": "bun run lint:types && bun run lint:js && bun run lint:css"
  },
  "devDependencies": {
    "@blinkdotnew/sdk": "2.11.3",
    "@dnd-kit/core": "6.3.1",
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "6.0.2",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.1.13",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "framer-motion": "14.9.0",
    "glob": "14.0.3",
    "globals": "17.13.0",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-hot-toast": "2.6.1",
    "react-responsive": "10.0.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6"
  },
  "resolutions": {
    "lucide-react": "0.577.0"
  }
}
